<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="App.Master.cs" Inherits="StudyLink.Web.MasterPages.App" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <title>StudyLink</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c256c" />
    <link rel="icon" href="<%: ResolveUrl("~/favicon.ico") %>" sizes="any" />
    <link rel="apple-touch-icon" href="<%: ResolveUrl("~/Images/branding/apple-touch-icon.png") %>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link href="<%: ResolveUrl("~/Content/css/studylink.css") %>" rel="stylesheet" />
    <%-- Dashboard favicon (brief: circular blue; dark tile when the OS is in dark mode). --%>
    <link rel="icon" type="image/png" href="<%: ResolveUrl("~/Images/branding/studylink-dashboard-icon.png") %>" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href="<%: ResolveUrl("~/Images/branding/studylink-dashboard-dark.png") %>" media="(prefers-color-scheme: dark)" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <form id="AppForm" runat="server">
        <div class="app-layout">
            <aside class="sidebar" id="sidebar" aria-label="Main navigation">
                <a class="sidebar__brand" href="<%: ResolveUrl(HomeUrl) %>">
                    <img src="<%: ResolveUrl("~/Images/branding/studylink-dashboard-dark.png") %>" alt="" />
                    <span>Study<b>Link</b></span>
                </a>
                <div class="sidebar__user">
                    <div class="avatar" aria-hidden="true"><asp:Literal ID="UserInitials" runat="server" /></div>
                    <div>
                        <div class="sidebar__name"><asp:Literal ID="UserName" runat="server" /></div>
                        <div class="sidebar__role"><asp:Literal ID="UserRole" runat="server" /></div>
                    </div>
                </div>
                <nav class="sidebar__nav"><asp:Literal ID="NavLinks" runat="server" /></nav>
                <div class="sidebar__footer">
                    <div class="sidebar__campus"><asp:Literal ID="CampusName" runat="server" /></div>
                    <asp:LinkButton ID="SignOutLink" runat="server" CssClass="sidebar__link" OnClick="SignOut_Click" CausesValidation="false">
                        <%= Icons.Svg("logout") %> Sign out
                    </asp:LinkButton>
                </div>
            </aside>
            <div class="sidebar-backdrop" data-nav-close="true"></div>

            <div class="app-main">
                <header class="app-topbar">
                    <button type="button" class="icon-btn menu-toggle" data-nav-toggle="true" aria-controls="sidebar" aria-label="Open menu"><%= Icons.Svg("menu") %></button>
                    <img class="app-topbar__logo" src="<%: ResolveUrl("~/Images/branding/studylink-mark.png") %>" alt="StudyLink" />
                    <p class="app-topbar__title"><asp:Literal ID="TopTitle" runat="server" /></p>
                    <details class="notif-menu">
                        <summary class="icon-btn" aria-label="Notifications"><%= Icons.Svg("bell") %><asp:Literal ID="BellCount" runat="server" /></summary>
                        <div class="notif-panel">
                            <asp:Literal ID="NotifItems" runat="server" />
                            <a class="notif-panel__item text-center fw-semibold" href="<%: ResolveUrl("~/Notifications/Index.aspx") %>">View all notifications</a>
                        </div>
                    </details>
                </header>

                <section class="page-hero">
                    <h1><asp:Literal ID="HeroTitle" runat="server" /></h1>
                    <asp:PlaceHolder ID="HeroSubtitleHolder" runat="server"><p><asp:Literal ID="HeroSubtitle" runat="server" /></p></asp:PlaceHolder>
                </section>

                <main id="main" class="app-content">
                    <div class="app-content__inner">
                        <asp:Literal ID="AlertArea" runat="server" />
                        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                    </div>
                </main>
                <footer class="app-footer">StudyLink &middot; Forte Books &amp; Tuition Hub &middot; Alice &middot; East London &middot; Bisho &middot; built by Nova Tech Developers</footer>
            </div>
        </div>
        <nav class="tabbar" aria-label="Quick navigation"><asp:Literal ID="TabLinks" runat="server" /></nav>
    </form>
    <script src="<%: ResolveUrl("~/Scripts/studylink.js") %>"></script>
</body>
</html>