<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Auth.Master.cs" Inherits="StudyLink.Web.MasterPages.Auth" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <title>StudyLink</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c256c" />
    <link rel="icon" href="<%: ResolveUrl("~/favicon.ico") %>" sizes="any" />
    <link rel="apple-touch-icon" href="<%: ResolveUrl("~/Images/branding/apple-touch-icon.png") %>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link href="<%: Asset.Url("~/Content/css/studylink.css") %>" rel="stylesheet" />
    <link rel="icon" type="image/png" href="<%: ResolveUrl("~/Images/branding/favicon-32.png") %>" sizes="32x32" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="AuthForm" runat="server">
        <div class="auth-layout">
            <aside class="auth-brand">
                <div>
                    <a class="auth-brand__logo" href="<%: ResolveUrl("~/Default.aspx") %>"><img src="<%: ResolveUrl("~/Images/branding/studylink-logo.png") %>" alt="StudyLink - Bringing students and tutors together." /></a>
                    <h2>Books, tutoring and academic resources in one place.</h2>
                    <p>Forte Books &amp; Tuition Hub's online platform for the Alice, East London and Bisho campuses.</p>
                    <ul>
                        <li><%= Icons.Svg("cap") %> Book verified tutors against real-time availability</li>
                        <li><%= Icons.Svg("book") %> Rent or buy prescribed textbooks</li>
                        <li><%= Icons.Svg("card") %> Pay fees online and keep every receipt</li>
                    </ul>
                </div>
                <small class="d-none d-lg-block" style="color:#9fb4e6">Built by Nova Tech Developers</small>
            </aside>
            <main class="auth-form-panel" id="main">
                <div class="auth-form">
                    <asp:Literal ID="AlertArea" runat="server" />
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </div>
            </main>
        </div>
    </form>
    <script src="<%: Asset.Url("~/Scripts/studylink.js") %>"></script>
</body>
</html>