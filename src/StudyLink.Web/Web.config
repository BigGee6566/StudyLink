<?xml version="1.0" encoding="utf-8"?>
<!--
  StudyLink - Books, Tutoring & Academic Resource Hub (Nova Tech Developers)
  Machine-specific values (demo seed password, mail mode) live in App_Data\local.settings.config,
  which is git-ignored; copy App_Data\local.settings.config.sample to create it.
-->
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>

  <connectionStrings>
    <!-- Windows authentication: no password in configuration. Change Data Source for another server. -->
    <add name="StudyLink" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=StudyLink;Integrated Security=True;MultipleActiveResultSets=True;Application Name=StudyLink" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings file="App_Data\local.settings.config">
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="StudyLink:MailFrom" value="StudyLink &lt;no-reply@studylink.local&gt;" />
    <!-- Pickup = write emails as .eml files to App_Data\MailDrop (development). Smtp = use mailSettings below. -->
    <add key="StudyLink:MailMode" value="Pickup" />
    <add key="StudyLink:SweepMinutes" value="60" />
    <add key="StudyLink:MigrateOnStart" value="true" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8.1" />
    <!-- 6 MB request limit: supplier invoice PDFs are capped at 5 MB by the service. -->
    <httpRuntime targetFramework="4.8.1" maxRequestLength="6144" enableVersionHeader="false" />
    <!-- en-GB: money renders R 1,234.56 and posted numbers always parse with a '.' decimal. -->
    <globalization culture="en-GB" uiCulture="en-GB" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <authentication mode="Forms">
      <forms name=".STUDYLINKAUTH" loginUrl="~/Account/Login.aspx" defaultUrl="~/Default.aspx" timeout="30"
             slidingExpiration="true" cookieless="UseCookies" protection="All" requireSSL="false" />
    </authentication>
    <authorization>
      <allow users="*" />
    </authorization>
    <sessionState mode="InProc" cookieless="UseCookies" timeout="30" cookieName="StudyLink.Session" />
    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" viewStateEncryptionMode="Always">
      <namespaces>
        <add namespace="StudyLink.Web.Infrastructure" />
        <add namespace="StudyLink.Data.Entities" />
      </namespaces>
    </pages>
    <customErrors mode="RemoteOnly" defaultRedirect="~/ErrorPages/Error500.aspx" redirectMode="ResponseRewrite">
      <error statusCode="404" redirect="~/ErrorPages/Error404.aspx" />
    </customErrors>
    <trace enabled="false" />
  </system.web>

  <!-- Role rules per folder: the first of three layers (pages and services check again). -->
  <location path="Student"><system.web><authorization><allow roles="Student" /><deny users="*" /></authorization></system.web></location>
  <location path="Tutor"><system.web><authorization><allow roles="Tutor" /><deny users="*" /></authorization></system.web></location>
  <location path="Staff"><system.web><authorization><allow roles="Staff" /><deny users="*" /></authorization></system.web></location>
  <location path="Supplier"><system.web><authorization><allow roles="Supplier" /><deny users="*" /></authorization></system.web></location>
  <location path="Manager"><system.web><authorization><allow roles="Manager" /><deny users="*" /></authorization></system.web></location>
  <location path="Admin"><system.web><authorization><allow roles="SystemAdmin" /><deny users="*" /></authorization></system.web></location>
  <location path="Operations"><system.web><authorization><allow roles="Staff,Manager,SystemAdmin" /><deny users="*" /></authorization></system.web></location>
  <location path="Notifications"><system.web><authorization><deny users="?" /></authorization></system.web></location>
  <location path="Account/Profile.aspx"><system.web><authorization><deny users="?" /></authorization></system.web></location>
  <location path="Account/ChangePassword.aspx"><system.web><authorization><deny users="?" /></authorization></system.web></location>
  <location path="Handlers/InvoiceFile.ashx"><system.web><authorization><deny users="?" /></authorization></system.web></location>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <!-- Web Forms emits inline __doPostBack script, hence 'unsafe-inline' for scripts. -->
        <add name="Content-Security-Policy" value="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering removeServerHeader="true">
        <hiddenSegments>
          <add segment="App_Data" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>

  <system.net>
    <mailSettings>
      <!-- Used when StudyLink:MailMode = Smtp. -->
      <smtp from="no-reply@studylink.local">
        <network host="localhost" port="25" />
      </smtp>
    </mailSettings>
  </system.net>

  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>